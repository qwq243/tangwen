# 环境变量清单。复制成 .env 用（.env 已被 .gitignore 挡住，不会进仓库）：
#
#     cp .env.example .env
#
# server.py 会自动读项目根目录的 .env；放别处就设 TYPESAFE_ENV_FILE 指过去。
# 服务器部署不必用这个文件 —— 直接给环境变量即可。
# Cloudflare Pages 那条路走的是 Pages Secret / 变量 / 绑定，见 docs/deployment.md。

# ─── 判题（想要十档印有准头，这一项必须有）─────────────────────────
# 没配的话把 JUDGE_MODE 改成 offline，见下面。值去 https://api.typesafe.ai 拿。
TYPESAFE_API_KEY=

# 判题接口地址。只有自己镜像了一层网关时才需要改。
# TYPESAFE_URL=https://api.typesafe.ai/v1/systemone

# 判题后端：
#   typesafe  默认。真判题，要上门的密钥。
#   offline   离线替身，不联网、不要密钥，判得不准 —— 只够把流程跑通，
#             让新克隆下来的人先玩得起来。**绝不要用在线上**。
# JUDGE_MODE=offline

# 密钥文件位置。默认就是本文件所在的 .env，一般不用设。
# TYPESAFE_ENV_FILE=/path/to/somewhere/.env

# ─── 求灯 / AI 提示（可选，两条路的任一条）────────────────────────
# 路 A：静态 API Token（服务器部署推荐）
# CF_ACCOUNT_ID=                 # 不填会自动问一次 Cloudflare API 拿账号列表
# CF_API_TOKEN=

# 路 B：复用 npx wrangler login 留下的 OAuth 凭据（本机开发省事）
#       token 过期会自动用 refresh_token 续期并写回，不用重新登录。
# WRANGLER_CONFIG=%APPDATA%/xdg.config/.wrangler/config/default.toml

# 都没配也不报错，只是求灯每次回同一句兜底；/api/health 的 hint 会是 false。

# ─── 后台「账房」（可选）───────────────────────────────────────────
# 登录 /admin/ 用的密钥，随便一串长随机数。没配则后台不可登录。
# ADMIN_KEY=

# ─── 运行时 ────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8765

# 排行榜 / 结案人数 / 埋点落在哪个目录（默认 ./data，会自动建）。
# 探针就是靠它把假数据写到临时目录，免得污染真数据。
# DATA_DIR=./tmp/_mydata
